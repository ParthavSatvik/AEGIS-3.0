    "max_reading_age_min": 10,
    "replan_budget": 3,
    "abstain_downtime_min": 180,
    "lambda_delay": 1.0,
    "max_diagnostics": 2,
    "verify_tolerance_pct": 2.0,
    "battery_max_discharge_kw": 120
  },
  "required_readings": ["battery_soc", "pump_B1", "grid_tie", "b1_rated_duty"],
