# AEGIS 3.0 environment variables. Copy to .env for local use. Never commit real secrets.
# Production values are set in the hosting dashboard (e.g. Render), not in files.

# development | production   (production: no /docs, no dev CORS, fails closed without access config)
AEGIS_ENV=development

# Network. Hosting platforms set PORT; locally AEGIS_PORT/AEGIS_HOST are used (default 127.0.0.1:8000).
# PORT=8000
AEGIS_HOST=127.0.0.1
AEGIS_PORT=8000

# Access control for a public demo: HTTP Basic auth on everything except /api/health.
AEGIS_BASIC_AUTH_USER=
AEGIS_BASIC_AUTH_PASSWORD=
# Only if you deliberately want an open demo in production:
# AEGIS_ALLOW_PUBLIC=true

# Resource limits
AEGIS_MAX_UPLOAD_MB=5
AEGIS_MAX_UPLOAD_ROWS=50000
AEGIS_MAX_DATASETS=20
AEGIS_MAX_BENCH_SEEDS=100

# Comma-separated extra CORS origins (development uses the Vite dev server origins by default)
# AEGIS_CORS_ORIGINS=http://localhost:5173

# Optional LLM (tool controller and explanations). Leave empty for the deterministic agent.
ANTHROPIC_API_KEY=
# AEGIS_LLM_MODEL=claude-haiku-5-5
# Seconds per LLM request, 0.5-60 (default 10). Invalid values fall back to the default; the app still starts.
# AEGIS_LLM_TIMEOUT=10
